# Copy to /etc/tracker/sync.env
TRACKER_API_URL=https://tracker.drnanoinc.com/api/ingest
TRACKER_TOKEN=change-me
TRACKER_CAPTURE_DIR=/var/lib/tracker/captures
TRACKER_DB_PATH=/var/lib/tracker/events.db
TRACKER_SYNC_INTERVAL=20
# Self-heal sweep: re-queue synced rows whose image is still on disk (idempotent).
TRACKER_SYNC_RESYNC_INTERVAL=300
# Give up on a pending row whose image never appears after this many hours.
TRACKER_SYNC_GIVEUP_HOURS=24
