# Copy to /etc/tracker/term.env (exports the reverse terminal agent).
# TRACKER_TOKEN is read from /etc/tracker/sync.env by term-agent.service.
TRACKER_TERM_URL=wss://tracker.drnanoinc.com/api/term
# Shell exposed at /terminal. Runs as the unprivileged `tracker` user; change
# User= in term-agent.service if you need root (not recommended).
TRACKER_TERM_SHELL=/bin/bash
TRACKER_TERM_COLS=120
TRACKER_TERM_ROWS=30
