[Unit]
Description=Vehicle line counter (ncnn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracker
Group=tracker
WorkingDirectory=/opt/tracker
EnvironmentFile=/etc/tracker/tracker.env
EnvironmentFile=/etc/tracker/sync.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tracker/venv/bin/python /opt/tracker/run.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
