# Copy to /etc/tracker/tracker.env
# Persistent storage so captures survive network outages (offline-first).
TRACKER_CAPTURE_DIR=/var/lib/tracker/captures
TRACKER_DB_PATH=/var/lib/tracker/events.db
# Force RTSP over TCP; fail fast on dead connections.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;5000000|rw_timeout;15000000
# The reader also self-heals: if no genuinely-new frame arrives for this many
# seconds it forces a reconnect (a stalled NVR can otherwise look healthy).
TRACKER_READ_TIMEOUT=15
# Live MJPEG relay to the dashboard (outbound POST; uses TRACKER_TOKEN)
TRACKER_LIVE_URL=https://tracker.drnanoinc.com/api/live
TRACKER_RETENTION_DAYS=30
# Detection runs on the NVR's 640x360 H.264 substream (set in config.json:
# .../unicast/c11/s1/live). YOLO26n INT8 @ 320x320 matches the (near-square)
# scan ROI, so no input padding is wasted. Faster profiles: 288x288, 256x256.
TRACKER_MODEL=yolo26n
TRACKER_MODEL_IMGSZ=320x320
# INT8-quantized model (model_int8.ncnn.param) — smaller + faster on ARM NEON.
# Calibrate on ROI crops, not whole frames:
#   tools/make_calib.py -> tools/quantize_int8.py. Set 0 for the fp32 model.
TRACKER_INT8=1
# Optional GPU compute (Pi 5 Vulkan) or GStreamer capture pipeline:
# TRACKER_VULKAN=1
# TRACKER_CAPTURE_PIPELINE=rtspsrc location=rtsp://... ! rtph264depay ! h264parse ! v4l2h264dec ! videoconvert ! appsink
# SHA-256-only RTSP Digest cameras (e.g. PT-NC120D3-WNM(D2)): FFmpeg's RTSP
# auth is MD5-only, so it gets 401. Enable the local RtspRelay shim (config.json
# must also set "relay": true): it authenticates with SHA-256, asks the camera
# for RTP over UDP to a loopback port, and OpenCV decodes the generated SDP.
# TRACKER_RTSP_RELAY=1
# TRACKER_RELAY_SDP=/tmp/tracker_rtsp_relay.sdp
# TRACKER_RELAY_PORT=5004
# Optional second camera shown raw on the dashboard (no detection). Point it at
# the camera's substream; the Pi relays it only while someone watches /live and
# closes the session (no bandwidth) otherwise. Enable on the VPS with CAM2=1.
# TRACKER_CAM2_URL=rtsp://admin:pass@192.168.225.70:554/Streaming/Channels/102?transportmode=unicast&profile=Profile_2
# TRACKER_CAM2_SDP=/tmp/tracker_cam2.sdp
# TRACKER_CAM2_PORT=5006
# Crossings are saved full-res from the camera's main-profile ONVIF snapshot
# (camera-side JPEG, no Pi decode); falls back to the substream frame on failure.
# URL/user/password default to the stream URL's; override only if needed.
# TRACKER_CAPTURE_URL=https://192.168.225.71/onvif-http/snapshot?Profile_1
# TRACKER_CAPTURE_USER=admin
# TRACKER_CAPTURE_PASSWORD=...secret...
# Motion arms detection and holds it open for this many seconds so a passing
# vehicle isn't missed between motion blobs.
TRACKER_MOTION_HOLD=60
TRACKER_MOTION_SCALE=0.5
TRACKER_MOTION_MIN_AREA=12
# Even with no motion, run YOLO at least this often (seconds) so a crossing is
# never missed entirely if the motion gate fails to fire.
TRACKER_MOTION_HEARTBEAT=3

# IoU tracker. Detections are matched to tracks by IoU against each track's
# velocity-predicted box (last box translated by px/s over the elapsed time).
# TRACKER_IOU_GATE is the minimum overlap to match (0.2 == ByteTrack's
# match_thresh 0.8); TRACKER_TRACK_MAX_AGE is how many frames a track coasts
# with no detection before it is dropped.
TRACKER_IOU_GATE=0.2
TRACKER_TRACK_MAX_AGE=25
# Across a stream freeze the box is extrapolated forward by velocity so a
# genuine constant-velocity detection still overlaps; PRED_CAP bounds only the
# coasted centroid used for display. VEL_RESET is the gap (s) after which the
# velocity estimate is re-measured from scratch instead of smoothed.
TRACKER_ASSOC_PRED_CAP=0.5
TRACKER_VEL_RESET=0.4
# Crossing gate: a track must have lived this many frames and travelled at
# least TRACKER_MIN_TRAVEL_FRAC of the frame height before a crossing counts.
TRACKER_MIN_TRACK_AGE=1
TRACKER_MIN_TRAVEL_FRAC=0.02
# Hysteresis past the line (fraction of frame height): the crossing sample must
# land at least this far on the new side, so a low-confidence box jittering
# across the line can't register a false crossing.
TRACKER_CROSS_MARGIN_FRAC=0.015
