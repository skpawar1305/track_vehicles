[Unit]
Description=Sync captures to VPS over HTTP (offline-first)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracker
Group=tracker
WorkingDirectory=/opt/tracker
EnvironmentFile=/etc/tracker/sync.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tracker/venv/bin/python /opt/tracker/sync.py
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
