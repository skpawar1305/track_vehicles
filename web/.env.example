DB_PATH=/srv/tracker/tracker.db
CAPTURES_DIR=/srv/tracker/captures
# Bearer token for /api/ingest and /api/live (used by the Pi)
TRACKER_TOKEN=change-me
# Browser Basic auth for the dashboard
DASH_USER=admin
DASH_PASS=change-me
PORT=3010
HOST=127.0.0.1
# Enable the reverse web terminal at /terminal (Pi dials out to it). Off by
# default: it grants an interactive shell as the Pi's `tracker` user.
ENABLE_TERMINAL=1
